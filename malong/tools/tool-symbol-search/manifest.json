{
  "name": "symbol_search",
  "version": "1.0.0",
  "description": "Find symbol definitions by name (substring). Usages? references. Before edit? impact_analysis.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_dir": {
        "type": "string",
        "description": "REQUIRED: project root (abs). reindex first if new."
      },
      "query": {
        "type": "string",
        "description": "Symbol name substring to search (case-sensitive)"
      },
      "limit": {
        "type": "number",
        "description": "Max results (default 30)"
      }
    },
    "required": [
      "workspace_dir",
      "query"
    ]
  },
  "handler": "./handler.js",
  "protocol_version": "1.0",
  "tags": [
    "search",
    "symbol"
  ],
  "dependencies": [
    "reindex"
  ]
}

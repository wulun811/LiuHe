{
  "name": "diff_facts",
  "version": "1.1.0",
  "description": "After edit_transaction: AST symbol changes, caller/test sync. No git.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_dir": {
        "type": "string",
        "description": "REQUIRED: Absolute path to the project root directory."
      },
      "since": {
        "type": "string",
        "description": "\"last_txn\" (default) or \"txn:<id>\" (get id from edit_transaction action=begin)"
      }
    },
    "required": ["workspace_dir"],
    "additionalProperties": false
  },
  "handler": "./handler.js",
  "protocol_version": "1.0",
  "tags": ["diff", "transaction", "ast"],
  "dependencies": ["edit_transaction"]
}

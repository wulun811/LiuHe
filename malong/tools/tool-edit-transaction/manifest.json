{
  "name": "edit_transaction",
  "version": "1.4.1",
  "description": "Multi-file edit with rollback/undo (begin->edit->commit); single-file edits don't need one.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_dir": { "type": "string", "description": "Project root (abs)." },
      "action": { "type": "string", "enum": ["begin", "edit", "edit_multi", "edit_chunk", "assemble", "commit", "undo_commit", "rollback", "info"], "description": "Action." },
      "name": { "type": "string", "description": "Txn name (begin)." },
      "txn_id": { "type": "string", "description": "Txn id." },
      "file": { "type": "string", "description": "Path (edit)." },
      "dry_run": { "type": "boolean", "description": "edit/edit_multi: validate only." },
      "create": { "type": "boolean", "description": "New file (needs content)." },
      "content": { "type": "string", "description": "File content (create)." },
      "files": { "type": "array", "items": { "type": "string" }, "description": "Broadcast to all." },
      "edits": {
        "type": "array",
        "description": "Array of {old_string,new_string} | {line_span,new_lines}; line_span {start_line,end_line,expect_sha}, end_line null=EOF.",
        "items": {
          "type": "object",
          "properties": {
            "old_string": { "type": "string" },
            "new_string": { "type": "string" },
            "new_lines": { "type": "array", "items": { "type": "string" } },
            "line_span": { "type": "object" }
          }
        }
      },
      "file_edits": { "type": "array", "description": "edit_multi: [{file, edits}] (same edit objects)." },
      "atomic": { "type": "boolean", "description": "Default true." },
      "seq": { "type": "integer", "description": "Chunk seq." },
      "total": { "type": "integer", "description": "Chunk count." },
      "lines": { "type": "array", "items": { "type": "string" }, "description": "Chunk lines." },
      "expect_sha": { "type": "string", "description": "assemble sha256." }
    },
    "required": ["workspace_dir", "action"]
  },
  "handler": "./handler.js",
  "protocol_version": "1.0",
  "tags": ["transaction", "edit", "atomic", "backup"],
  "dependencies": []
}
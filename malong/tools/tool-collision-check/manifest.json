{
  "name": "collision_check",
  "version": "1.0.0",
  "description": "Check if a file was modified since last read. Record read snapshots, compare content hashes before editing. Zero token, session-level.",
  "handler": "handler.js",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_dir": {
        "type": "string",
        "description": "Project root absolute path"
      },
      "file": {
        "type": "string",
        "description": "File path (relative to workspace_dir)"
      },
      "action": {
        "type": "string",
        "enum": ["record_read", "check"],
        "description": "record_read: snapshot after reading; check: verify before editing"
      },
      "session_id": {
        "type": "string",
        "description": "Optional session ID (default: \"default\")"
      }
    },
    "required": ["workspace_dir", "file", "action"],
    "additionalProperties": false
  }
}

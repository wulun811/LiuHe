{
  "name": "exception_guard",
  "version": "1.0.0",
  "description": "Check raise/throw uses project exceptions vs builtins, module-scoped (falls back to project scope). Fix → verify test_bridge. Pairs config_drift.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_dir": {
        "type": "string",
        "description": "REQUIRED: project root (abs)."
      },
      "file": {
        "type": "string",
        "description": "File to check (relative to workspace_dir)"
      }
    },
    "required": [
      "workspace_dir",
      "file"
    ]
  },
  "handler": "./handler.js",
  "protocol_version": "1.0",
  "tags": [
    "quality",
    "exceptions"
  ],
  "dependencies": [
    "reindex"
  ]
}

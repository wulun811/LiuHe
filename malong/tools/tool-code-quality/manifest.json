{
  "name": "code_quality",
  "version": "1.0.0",
  "description": "Read-only 5-dim JSON scores (techDebt/archViolation/blastRadius/overEngineering/paradigmFit). Findings? code_review.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_dir": {
        "type": "string",
        "description": "REQUIRED: project root (abs)."
      },
      "file": {
        "type": "string",
        "description": "File to probe, relative to workspace_dir"
      }
    },
    "required": [
      "workspace_dir",
      "file"
    ]
  },
  "handler": "./handler.js",
  "protocol_version": "1.0",
  "tags": [
    "quality",
    "analysis"
  ],
  "dependencies": []
}

{
  "name": "naming_check",
  "version": "1.0.0",
  "description": "Check naming consistency: style (snake/camel/Pascal), verb preferences, semantic synonyms. Per-language analysis. Zero LLM.",
  "handler": "handler.js",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_dir": {
        "type": "string",
        "description": "Project root absolute path"
      },
      "file": {
        "type": "string",
        "description": "File to check (relative to workspace_dir)"
      },
      "new_symbols": {
        "type": "array",
        "items": { "type": "string" },
        "description": "New symbol names to check"
      },
      "lang": {
        "type": "string",
        "description": "Optional: python|javascript|typescript|go|rust|java (default: by extension)"
      }
    },
    "required": ["workspace_dir", "file", "new_symbols"],
    "additionalProperties": false
  }
}
